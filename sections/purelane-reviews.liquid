{% comment %}
  Purelane — reviews rail (prototype anchor #reviews)

  Reviews are a `review` metaobject, so marketing adds one in admin without touching code
  and without a developer deploying a theme change. That is the honest answer to the
  brief's "where a native field doesn't exist, solve it properly": Shopify has no native
  testimonial object, and hardcoding five <article> blocks into Liquid would fail the
  merchant-editable requirement outright.

  The rail is a CSS scroll container, not a JS carousel. It works without JavaScript,
  scrolls with a trackpad, drag or keyboard, and costs nothing on the main thread.
{% endcomment %}

{% render 'purelane-assets' %}

{%- liquid
  # Three sources, in order of intent:
  #   1. the reviews the merchant explicitly picked
  #   2. every review metaobject in the shop, so the section works the moment the
  #      metaobjects exist and nobody has to hand-pick them
  #   3. editor blocks, so the section is still usable before any metaobject is created
  assign reviews = section.settings.reviews.value
  assign review_count = reviews | size
  if review_count == 0
    assign reviews = shop.metaobjects.review.values
    assign review_count = reviews | size
  endif
  assign use_blocks = false
  if review_count == 0
    assign use_blocks = true
  endif
-%}

<div class="pl">
  <section
    class="sec revband tone-{{ section.settings.tone | default: '1' }}"
    id="reviews"
    data-purelane-section
    data-section-id="{{ section.id }}"
  >
    <div class="wrap">
      <div class="revhead rv">
        {%- comment -%}
          The prototype's reviews band has no display heading — the kicker is the only
          label. Rendering it as a span left the section invisible to heading navigation,
          so it is an h2 carrying the same .kicker styling: identical pixels, real
          document structure.
        {%- endcomment -%}
        {%- if section.settings.kicker != blank -%}
          <h2 class="kicker">{{ section.settings.kicker }}</h2>
        {%- endif -%}
        {%- if section.settings.aggregate_rating != blank -%}
          <span class="agg">
            <span class="st" aria-hidden="true">★★★★★</span>
            <b>{{ section.settings.aggregate_rating }}</b>
            {{ section.settings.aggregate_label }}
          </span>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <span class="agg">{{ section.settings.secondary_label }}</span>
        {%- endif -%}
      </div>
    </div>

    <div class="revrail rv" tabindex="0" role="group" aria-label="Customer reviews">
      {%- comment -%}
        The marquee animates to translateX(-50%), so the track has to hold TWO copies of
        the set — at the halfway point copy two is exactly where copy one started and the
        loop is seamless. Rendering the reviews once meant the animation ran the track
        clean off its own content and left a growing empty gap at the tail.

        The second copy is aria-hidden and its cards are removed from the tab order, so
        the duplication is purely visual: a screen reader and a keyboard user each meet
        every review exactly once.
      {%- endcomment -%}
      <div class="revtrack">
        {%- for pass in (1..2) -%}
          {%- assign is_clone = false -%}
          {%- if pass == 2 -%}
            {%- assign is_clone = true -%}
          {%- endif -%}
          <div class="revset"
            {% if is_clone %}aria-hidden="true"{% endif %}>
            {%- if use_blocks -%}
              {%- for block in section.blocks -%}
                <article class="glass-2 rcard" {% unless is_clone %}{{ block.shopify_attributes }}{% endunless %}>
                  {%- render 'purelane-review-card',
                        rating: block.settings.rating,
                        title: block.settings.title,
                        body: block.settings.body,
                        author: block.settings.author,
                        context: block.settings.context -%}
                </article>
              {%- endfor -%}
            {%- else -%}
              {%- for review in reviews -%}
                <article class="glass-2 rcard">
                  {%- render 'purelane-review-card',
                        rating: review.rating,
                        title: review.title,
                        body: review.body,
                        author: review.author,
                        context: review.context -%}
                </article>
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Purelane reviews",
  "tag": "section",
  "class": "purelane-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "aggregate_rating",
      "label": "Aggregate rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "aggregate_label",
      "label": "Aggregate label",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary stat",
      "default": "Loved by 12 lakh+ homes"
    },
    {
      "type": "metaobject_list",
      "id": "reviews",
      "metaobject_type": "review",
      "label": "Reviews",
      "info": "Add reviews in Content > Metaobjects. Falls back to the blocks below if empty."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background tone",
      "info": "Matches the prototype's scroll gradient. 1 is lightest, 4 deepest.",
      "options": [
        {
          "value": "1",
          "label": "1 — lightest"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4 — deepest"
        }
      ],
      "default": "1"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review (fallback)",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "text",
          "id": "context",
          "label": "Product context"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane reviews"
    }
  ]
}
{% endschema %}
