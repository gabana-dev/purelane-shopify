{% comment %}
  Purelane — hero (prototype anchor section.hero)

  The headline is three stacked lines with the last one highlighted, so each line is its
  own setting rather than one string with <br> tags a merchant would have to hand-write.

  Promise badges and hero slides are blocks: marketing can add, remove and reorder them in
  the editor without a developer. Slides reference real products, so the hero image is the
  product's own image and changes when merchandising changes.
{% endcomment %}

{% render 'purelane-assets' %}

{%- liquid
  assign badge_blocks = section.blocks | where: 'type', 'badge'
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign autoplay = section.settings.autoplay_interval | times: 1000
  unless section.settings.autoplay
    assign autoplay = 'off'
  endunless
-%}

<div class="pl">
  <section
    class="hero tone-{{ section.settings.tone | default: '1' }}"
    data-purelane-section
    data-section-id="{{ section.id }}"
    {% if slide_blocks.size > 1 %}data-carousel data-autoplay="{{ autoplay }}"{% endif %}
    {% if section.settings.enable_parallax %}data-parallax-host{% endif %}
  >
    <div class="hero-grid">
      {%- if badge_blocks.size > 0 -%}
        <div class="badges glass-2" aria-label="Product promises">
          {%- for block in badge_blocks -%}
            <div class="badge" {{ block.shopify_attributes }}>
              <span class="bi">{% render 'purelane-icon', icon: block.settings.icon %}</span>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="hero-copy">
        {%- comment -%}
          One h1 for the page. The highlighted last line is a separate setting so the
          merchant controls which word is emphasised without writing markup.
        {%- endcomment -%}
        <h1 class="d1 rv in">
          {{ section.settings.heading_line_1 }}<br>
          {{ section.settings.heading_line_2 }}<br>
          <span class="lime">{{ section.settings.heading_highlight }}</span>
        </h1>

        <div class="rule rv rv-d1" aria-hidden="true">
          <i></i>{% render 'purelane-icon', icon: 'leaf' %}<i></i>
        </div>

        {%- if section.settings.lede != blank -%}
          <p class="lede rv rv-d2">{{ section.settings.lede }}</p>
        {%- endif -%}

        <div class="hero-cta rv rv-d3">
          {%- if section.settings.primary_label != blank -%}
            <a class="btn btn-primary" href="{{ section.settings.primary_link | default: '#shop' }}">
              {{ section.settings.primary_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a class="btn btn-ghost" href="{{ section.settings.secondary_link | default: '#shop' }}">
              {{ section.settings.secondary_label }}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- if slide_blocks.size > 0 -%}
        <div class="hero-prod" data-parallax>
          <div class="hstage">
            {%- for block in slide_blocks -%}
              {%- liquid
                # A slide shows one, two or three bottles with a price tag — the prototype
                # is selling bundle tiers here, not rotating featured products.
                assign slide_products = ''
                assign p1 = all_products[block.settings.product_1]
                assign p2 = all_products[block.settings.product_2]
                assign p3 = all_products[block.settings.product_3]
                assign price_product = all_products[block.settings.price_product]

                assign count = 0
                if p1 != blank
                  assign count = count | plus: 1
                endif
                if p2 != blank
                  assign count = count | plus: 1
                endif
                if p3 != blank
                  assign count = count | plus: 1
                endif

                assign on_sale = false
                if price_product.compare_at_price > price_product.price
                  assign on_sale = true
                  assign saving = price_product.compare_at_price | minus: price_product.price
                  assign discount = saving | times: 100.0 | divided_by: price_product.compare_at_price | round
                endif
              -%}
              <div
                class="hslide hs{{ count }} {% if forloop.first %}on{% endif %}"
                data-slide
                aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- assign positions = 'a,b,c' | split: ',' -%}
                {%- for prod in (1..3) -%}
                  {%- liquid
                    case forloop.index
                      when 1
                        assign item = p1
                      when 2
                        assign item = p2
                      when 3
                        assign item = p3
                    endcase
                    assign pos = positions[forloop.index0]
                  -%}
                  {%- if item != blank and item.featured_image != blank -%}
                    {%- liquid
                      if forloop.first
                        assign img_loading = 'eager'
                        assign img_priority = 'high'
                      else
                        assign img_loading = 'lazy'
                        assign img_priority = 'auto'
                      endif
                    -%}
                    <span class="hp {{ pos }} d{{ forloop.index }}">
                      {{
                        item.featured_image
                        | image_url: width: 700
                        | image_tag:
                          loading: img_loading,
                          fetchpriority: img_priority,
                          decoding: 'async',
                          widths: '200,300,450,700',
                          sizes: '(min-width: 1024px) 300px, 40vw',
                          alt: item.title
                      }}
                    </span>
                  {%- endif -%}
                {%- endfor -%}

                {%- if block.settings.label != blank and price_product != blank -%}
                  <div class="glass-2 ptag">
                    <span class="lbl">{{ block.settings.label }}</span>
                    <span class="val">
                      <strong>{{ price_product.price | money }}</strong>
                      {%- if on_sale -%}<s>{{ price_product.compare_at_price | money }}</s>{%- endif -%}
                    </span>
                    {%- if on_sale -%}
                      <span class="cut">
                        {%- if count > 1 -%}Save {{ saving | money }}{%- else -%}{{ discount }}% off{%- endif -%}
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if slide_blocks.size > 1 -%}
            <div class="hdots" role="tablist" aria-label="Choose a bundle size">
              {%- for block in slide_blocks -%}
                <button
                  type="button"
                  role="tab"
                  data-slide-dot
                  class="{% if forloop.first %}on{% endif %}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                >
                  <span class="visually-hidden">
                    Show {{ block.settings.label | default: 'bundle' | escape }}
                  </span>
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Purelane hero",
  "tag": "section",
  "class": "purelane-section",
  "settings": [
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Clean"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "That"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted line",
      "info": "Rendered in the accent colour",
      "default": "Lasts"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro paragraph",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Shop bestsellers"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "Build a bundle"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate products",
      "default": true,
      "info": "Always disabled for visitors who prefer reduced motion."
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Seconds per product",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "Parallax on the product",
      "default": true,
      "info": "Desktop only, and off for reduced motion."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background tone",
      "info": "Matches the prototype's scroll gradient. 1 is lightest, 4 deepest.",
      "options": [
        {
          "value": "1",
          "label": "1 — lightest"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4 — deepest"
        }
      ],
      "default": "1"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Promise badge",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "no-chemicals",
              "label": "No chemicals"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "truck",
              "label": "Delivery"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Plant powered"
        }
      ]
    },
    {
      "type": "slide",
      "name": "Bundle slide",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "e.g. Single bottle, Any 2 products",
          "default": "Single bottle"
        },
        {
          "type": "product",
          "id": "price_product",
          "label": "Price comes from",
          "info": "Price, compare-at and the saving are read from this product."
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Bottle 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Bottle 2 (optional)"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Bottle 3 (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane hero",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "leaf",
            "label": "Plant powered"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "shield",
            "label": "Safe for kids & pets"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "no-chemicals",
            "label": "Zero harsh chemicals"
          }
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
